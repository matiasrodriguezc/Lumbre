{
  "espacio": {
    "space-1": {
      "$type": "number",
      "$value": 4.0,
      "$description": "Separación ícono–texto dentro de un chip.",
      "$extensions": {
        "com.figma.scopes": [
          "GAP",
          "WIDTH_HEIGHT"
        ],
        "com.figma.codeSyntax": {
          "WEB": "var(--space-1)",
