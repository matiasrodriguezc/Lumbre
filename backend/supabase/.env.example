# Copiar como supabase/.env (no va al repo) y completar con las credenciales de H1.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---------------------------------------------------------------
# Edge Functions: copiar este bloque como supabase/functions/.env (no va al repo).
# En remoto: supabase secrets set --env-file supabase/functions/.env
# Todo es opcional: sin claves, la IA usa el proveedor local simulado y los embeddings locales.
# ---------------------------------------------------------------
# Solo local: habilita /dev-plan (cambiar el plan sin pasar por la tienda). Nunca en staging ni prod.
LUMBRE_DEV_TOOLS=true

# IA. Con ANTHROPIC_API_KEY el gateway usa Anthropic; sin ella, el proveedor local.
ANTHROPIC_API_KEY=
# local | anthropic (fuerza el proveedor aunque haya clave)
LUMBRE_AI_PROVIDER=
LUMBRE_MODEL_FAST=claude-haiku-4-5
LUMBRE_MODEL_DEEP=claude-sonnet-5
LUMBRE_MODEL_FALLBACK=claude-haiku-5-5

# Embeddings. Con VOYAGE_API_KEY usa voyage-3.5 (1024 dimensiones); sin ella, el hashing local.
# Cambiar de modelo re-embebe todo de a poco (/process).
VOYAGE_API_KEY=
# local | (vacío = voyage si hay clave)
LUMBRE_EMBEDDINGS=
LUMBRE_EMBEDDING_MODEL=voyage-3.5

# Analytics de servidor. Sin clave, los eventos se escriben en el log.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Push (APNs, token .p8). Sin claves, /send-pushes solo loguea y marca la chispa como avisada.
APNS_KEY_ID=
APNS_TEAM_ID=
# Contenido del .p8 en una línea, con \n en los saltos.
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=

# Webhook de RevenueCat: el valor del Authorization header configurado en RevenueCat.
REVENUECAT_WEBHOOK_SECRET=

# Opcional: un secreto propio para las funciones internas (además de la clave de servicio).
LUMBRE_CRON_SECRET=

# Integridad del dispositivo (paso 40): off (default) | report (verifica y loguea, no bloquea) | enforce (403 attestation_failed).
# Local y dev quedan en off; en prod, primero report unos días y después enforce.
LUMBRE_ATTESTATION=off
# App Attest: "<team id>.<bundle id>" (si falta, APNS_TEAM_ID + APNS_BUNDLE_ID). Acepta claves del entorno de
# desarrollo de Apple salvo APP_ATTEST_ALLOW_DEVELOPMENT=false (ponerlo así en prod).
APP_ATTEST_APP_ID=
APP_ATTEST_ALLOW_DEVELOPMENT=true
# Opcional: otra raíz (la de Apple viene en el código).
APPLE_APP_ATTEST_ROOT_PEM=
# Play Integrity: el JSON entero de la cuenta de servicio de Google Cloud (rol para la Play Integrity API) y el paquete.
PLAY_INTEGRITY_SERVICE_ACCOUNT=
ANDROID_PACKAGE_NAME=
PLAY_INTEGRITY_ALLOW_BASIC=false

# Límites anti-abuso por usuario (provisorios).
LUMBRE_SEARCH_PER_HOUR=120
LUMBRE_TODAY_PER_HOUR=300
# Tope de páginas de un PDF para destilar.
LUMBRE_MAX_PDF_PAGES=30

# Web pública (funciones waitlist y demo-spark). Todo opcional; defaults y detalle en web/README.md.
# Base de los links de los mails (default http://localhost:55580).
LUMBRE_SITE_URL=
# Orígenes permitidos por CORS, separados por coma (vacío: cualquiera). En prod, el dominio de la web.
LUMBRE_WEB_ORIGINS=
# mailpit (default en local) | log (default en remoto: no manda nada).
LUMBRE_MAIL_PROVIDER=
# Mailpit dentro de la red de Docker del stack (default http://supabase_inbucket_lumbre:8025).
MAILPIT_URL=
# Remitente (defaults hola@lumbre.local y Lumbre).
LUMBRE_MAIL_FROM=
LUMBRE_MAIL_FROM_NAME=
# Sal de los hashes de IP y email de los límites (default: derivada de la clave de servicio). En prod, una propia.
LUMBRE_RATE_SALT=
