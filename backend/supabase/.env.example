# Copiar como supabase/.env (no va al repo) y completar con las credenciales de H1.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ---------------------------------------------------------------
# Edge Functions: copiar este bloque como supabase/functions/.env (no va al repo).
# En remoto: supabase secrets set --env-file supabase/functions/.env
# Todo es opcional: sin claves, la IA usa el proveedor local simulado y los embeddings locales.
# ---------------------------------------------------------------
# Solo local: habilita /dev-plan (cambiar el plan sin pasar por la tienda). Nunca en staging ni prod.
LUMBRE_DEV_TOOLS=true

# IA. Con ANTHROPIC_API_KEY el gateway usa Anthropic; sin ella, el proveedor local.
ANTHROPIC_API_KEY=
# local | anthropic (fuerza el proveedor aunque haya clave)
LUMBRE_AI_PROVIDER=
LUMBRE_MODEL_FAST=claude-haiku-4-5
LUMBRE_MODEL_DEEP=claude-sonnet-5
LUMBRE_MODEL_FALLBACK=claude-haiku-5-5

# Embeddings. Con VOYAGE_API_KEY usa voyage-3.5 (1024 dimensiones); sin ella, el hashing local.
# Cambiar de modelo re-embebe todo de a poco (/process).
VOYAGE_API_KEY=
# local | (vacío = voyage si hay clave)
LUMBRE_EMBEDDINGS=
LUMBRE_EMBEDDING_MODEL=voyage-3.5

# Analytics de servidor. Sin clave, los eventos se escriben en el log.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Push (APNs, token .p8). Sin claves, /send-pushes solo loguea y marca la chispa como avisada.
APNS_KEY_ID=
APNS_TEAM_ID=
# Contenido del .p8 en una línea, con \n en los saltos.
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=

# Webhook de RevenueCat: el valor del Authorization header configurado en RevenueCat.
REVENUECAT_WEBHOOK_SECRET=

# Opcional: un secreto propio para las funciones internas (además de la clave de servicio).
LUMBRE_CRON_SECRET=
