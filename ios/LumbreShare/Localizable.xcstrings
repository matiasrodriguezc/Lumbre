      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write it in one sentence"
          }
        }
      }
    },
    "Guardada. Se suma a tu Red cuando abras Lumbre." : {
      "comment" : "Sin sesión o sin conexión: queda en la cola compartida. [compartir.queued]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved. It joins your Network when you open Lumbre."
