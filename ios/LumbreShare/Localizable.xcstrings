          "stringUnit" : {
            "state" : "translated",
            "value" : "Category"
          }
        }
      }
    },
    "Compartir con Lumbre todavía no está disponible." : {
      "comment" : "Con el feature flag apagado. [compartir.unavailable]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharing to Lumbre isn't available yet."
          }
        }
      }
    },
    "Dejala en %lld caracteres o menos" : {
      "comment" : "[compartir.limit]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it to %lld characters or fewer"
          }
        }
      }
    },
    "El PDF pesa más de 20 MB. Probá con uno más liviano." : {
      "comment" : "[capturar.pdf_too_big]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PDF is over 20 MB. Try a lighter one."
          }
        }
      }
    },
