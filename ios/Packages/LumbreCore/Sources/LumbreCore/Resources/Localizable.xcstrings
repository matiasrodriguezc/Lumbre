{
  "sourceLanguage" : "es",
  "strings" : {
    "Algo salió mal. Probá de nuevo." : {
      "comment" : "[comun.something_wrong_retry]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong. Try again."
          }
        }
      }
    },
    "Con el plan gratis tenés un circuito. Con Pro, todos los que quieras." : {
      "comment" : "[comun.free_one_circuit]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The free plan has one circuit. With Pro, as many as you want."
          }
        }
      }
    },
    "Creá tu cuenta para usar esto." : {
      "comment" : "[errores.api.account_required]",
