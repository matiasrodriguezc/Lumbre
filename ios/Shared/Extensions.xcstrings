{
  "sourceLanguage" : "es",
  "strings" : {
    "Abre Capturar para sumar una neurona a tu Red." : {
      "comment" : "Descripción del widget de captura en la galería. [widget.capture_description]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens Capture to add a neuron to your Network."
          }
        }
      }
    },
    "Abre Lumbre en la chispa del día." : {
      "comment" : "[siri.today_description]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens Lumbre on today's spark."
          }
        }
      }
    },
    "Abre Lumbre listo para guardar una idea." : {
      "comment" : "[siri.capture_description]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens Lumbre ready to save an idea."
          }
        }
      }
    },
    "Abrí Lumbre" : {
      "comment" : "Sin datos, widget rectangular. [widget.open]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Lumbre"
          }
        }
      }
    },
    "Abrí Lumbre para encenderla" : {
      "comment" : "Lo mismo, debajo del título. [widget.ready_body]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Lumbre to light it"
          }
        }
      }
    },
    "Abrí Lumbre para ver la chispa del día" : {
      "comment" : "Sin datos, debajo del título (\"Tu chispa de hoy\"). [widget.no_data_body]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Lumbre to see today's spark"
          }
        }
      }
    },
    "Capturar" : {
      "comment" : "Botón + flotante y accesos para guardar una idea. [comun.capture]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture"
          }
        }
      }
    },
    "Capturar en Lumbre" : {
      "comment" : "Control del Centro de control (iOS 18) y título del App Intent que abre Capturar. [widget.control_capture]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture in Lumbre"
