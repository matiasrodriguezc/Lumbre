        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves a neuron to your Network without opening the app."
          }
        }
      }
    },
    "Guardada. Se suma a tu Red la próxima vez que abras Lumbre." : {
      "comment" : "[siri.queued]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved. It joins your Network next time you open Lumbre."
          }
        }
      }
    },
    "Guardar ${idea} en ${category}" : {
      "comment" : "Resumen del intent en Atajos. [siri.save_summary]",
