      "comment" : "[comun.category]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Category"
          }
        }
      }
    },
    "Chispa de hoy" : {
      "comment" : "Nombre del widget en la galería y encabezado en la pantalla bloqueada. [widget.spark_name]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today's spark"
          }
        }
      }
    },
    "Elegí una categoría." : {
      "comment" : "[siri.empty_category]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a category."
          }
        }
      }
    },
    "Escribí la idea que querés guardar." : {
      "comment" : "[siri.empty_idea]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write the idea you want to save."
          }
        }
      }
    },
    "Esto todavía no está disponible en Lumbre." : {
      "comment" : "Con el feature flag apagado. [siri.unavailable]",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This isn't available in Lumbre yet."
          }
        }
      }
    },
    "Guarda una neurona en tu Red sin abrir la app." : {
      "comment" : "[siri.save_description]",
